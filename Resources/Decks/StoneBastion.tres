[resource]
script = ExtResource("1_deck")
Name = "Stone Bastion"
Cards = Array[ExtResource("2_card")]([ExtResource("c_Guardian"), ExtResource("c_StonePathfinder"), ExtResource("c_BatteringRam"), ExtResource("c_BatteringRam"), ExtResource("c_StoneGolem"), ExtResource("c_StoneGolem"), ExtResource("c_RockSlinger"), ExtResource("c_RockSlinger"), ExtResource("c_Lancer"), ExtResource("c_Lancer"), ExtResource("c_Thornback"), ExtResource("c_Thornback"), ExtResource("c_Scout"), ExtResource("c_Scout"), ExtResource("c_Miner"), ExtResource("c_Merchant"), ExtResource("c_StoneWall"), ExtResource("c_StoneWall"), ExtResource("c_Gale"), ExtResource("c_Gale"), ExtResource("c_Stoneskin"), ExtResource("c_Stoneskin"), ExtResource("c_Rockslide"), ExtResource("c_Rockslide"), ExtResource("c_FrostMage"), ExtResource("c_FrostMage"), ExtResource("c_Cleric"), ExtResource("c_Cleric"), ExtResource("c_BoneKnight"), ExtResource("c_BoneKnight")])
Description = "Hold the line. Shields, walls and heavy brutes shove enemies off the zone and onto your terms. Splash: frost and healing."
AccentColor = Color(0.72, 0.64, 0.5, 1)
Showcase = ExtResource("c_StoneGolem")
