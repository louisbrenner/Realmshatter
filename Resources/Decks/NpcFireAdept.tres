[resource]
script = ExtResource("1_deck")
Name = "Sorcha's Blaze"
Cards = Array[ExtResource("2_card")]([ExtResource("c_Swordsman"), ExtResource("c_Swordsman"), ExtResource("c_Swordsman"), ExtResource("c_Guardian"), ExtResource("c_Guardian"), ExtResource("c_Lancer"), ExtResource("c_Lancer"), ExtResource("c_Lancer"), ExtResource("c_Archer"), ExtResource("c_Miner"), ExtResource("c_Miner"), ExtResource("c_Merchant"), ExtResource("c_ManaSurge"), ExtResource("c_ManaSurge"), ExtResource("c_EmberStalker"), ExtResource("c_EmberStalker"), ExtResource("c_FlameArcher"), ExtResource("c_FlameArcher"), ExtResource("c_FlameArcher"), ExtResource("c_EmberImp"), ExtResource("c_EmberImp"), ExtResource("c_Berserker"), ExtResource("c_Berserker"), ExtResource("c_AshenRaider"), ExtResource("c_PyreOffering"), ExtResource("c_FlameWall"), ExtResource("c_FlameWall"), ExtResource("c_Fireball"), ExtResource("c_EmberEngineer"), ExtResource("c_FlameWarden")])
