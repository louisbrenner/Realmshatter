Cards = Array[ExtResource("2_card")]([ExtResource("c_Swordsman"), ExtResource("c_Swordsman"), ExtResource("c_Swordsman"), ExtResource("c_Guardian"), ExtResource("c_Guardian"), ExtResource("c_Guardian"), ExtResource("c_Lancer"), ExtResource("c_Lancer"), ExtResource("c_Lancer"), ExtResource("c_Archer"), ExtResource("c_Archer"), ExtResource("c_Archer"), ExtResource("c_Hrimgar"), ExtResource("c_FrostWyrm"), ExtResource("c_RimeStalker"), ExtResource("c_RimeStalker"), ExtResource("c_FrostArcher"), ExtResource("c_FrostArcher"), ExtResource("c_FrostArcher"), ExtResource("c_FrostMage"), ExtResource("c_FrostMage"), ExtResource("c_IceSentinel"), ExtResource("c_IceSentinel"), ExtResource("c_Frostbite"), ExtResource("c_Frostbite"), ExtResource("c_Hailstorm"), ExtResource("c_Hailstorm"), ExtResource("c_RimeWarden"), ExtResource("c_IcebowEngineer"), ExtResource("c_Scout")])
