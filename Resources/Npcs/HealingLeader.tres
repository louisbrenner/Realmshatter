[resource]
script = ExtResource("1_npc")
Id = "healing_leader"
Name = "Seraphine"
Title = "Dawn Covenant · Clan Leader"
Clan = 2
Deck = ExtResource("3_deck")
House = 2
Position = Vector2(480, 215)
Greeting = "I am Seraphine, High Priestess of the Dawn Covenant. My pieces simply refuse to fall. Will you test them?"
RematchLine = "The dawn rises again. Shall we?"
DefeatLine = "Light shines through you. The Archangel will walk at your side now."
VictoryLine = "Rest, child. The Covenant gratefully accepts your tithe."
RewardGold = 150
RewardCards = Array[ExtResource("2_card")]([ExtResource("r_Archangel"), ExtResource("r_Archangel"), ExtResource("r_MendingRain"), ExtResource("r_MendingRain"), ExtResource("r_Templar"), ExtResource("r_Templar")])
BonusApPerTurn = 1
RequiresDefeated = Array[String](["healing_initiate", "healing_adept", "healing_champion"])
LockedLine = "Prove yourself against the three duelists of this hall first - then I will face you."
