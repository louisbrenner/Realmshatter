[resource]
script = ExtResource("1_npc")
Id = "fire_apprentice"
Name = "Kira"
Title = "Ember Apprentice"
Clan = 1
Deck = ExtResource("3_deck")
Position = Vector2(270, 430)
Greeting = "Hey, you! I bet my embers burn hotter than anything in your deck. Wanna find out?"
RematchLine = "Back for another scorching? I have been practising!"
DefeatLine = "Ow, ow, ow... fine, you win. Take this - you earned it."
VictoryLine = "Ha! Too hot to handle? Your coin purse melted - I'll take what dripped out."
RewardGold = 60
RewardCards = Array[ExtResource("2_card")]([ExtResource("r_AshenRaider"), ExtResource("r_AshenRaider"), ExtResource("r_EmberImp"), ExtResource("r_EmberEngineer")])
