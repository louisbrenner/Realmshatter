[resource]
script = ExtResource("1_npc")
Id = "realmshatter"
Name = "Malrec"
Title = "The Realmshatter · Endboss"
Clan = 0
Deck = ExtResource("3_deck")
Position = Vector2(960, 400)
Greeting = "So you broke all five clans. I broke the realm itself. Their legends kneel before my throne - win one, if you can."
RematchLine = "Back for another crown? The legends are still mine to give."
DefeatLine = "Impossible... Take it. A legend should never serve a loser."
VictoryLine = "Shattered, like everyone before you."
RewardGold = 500
BonusApPerTurn = 2
RewardOneOf = Array[ExtResource("2_card")]([ExtResource("l_Ignis"), ExtResource("l_Solenne"), ExtResource("l_Hrimgar"), ExtResource("l_Voltaris"), ExtResource("l_Gorran")])
RequiresDefeated = Array[String](["fire_leader", "healing_leader", "frost_leader", "storm_leader", "stone_leader"])
LockedLine = "The Realmshatter only duels those who have humbled every clan leader. Come back when all five have fallen."
