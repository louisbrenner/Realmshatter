[resource]
script = ExtResource("1_npc")
Id = "fire_leader"
Name = "Varkas"
Title = "Ember Legion · Clan Leader"
Clan = 1
Deck = ExtResource("3_deck")
House = 1
Position = Vector2(480, 215)
Greeting = "I am Varkas, Pyrelord of the Ember Legion. Few leave my table unburnt. Do you dare?"
RematchLine = "The flames remember you. Shall we dance again?"
DefeatLine = "Impressive... The Phoenix chooses its own master. Today it chose you."
VictoryLine = "Ashes. As expected. Your tribute is accepted, little spark."
RewardGold = 150
RewardCards = Array[ExtResource("2_card")]([ExtResource("r_Phoenix"), ExtResource("r_Phoenix"), ExtResource("r_Meteor"), ExtResource("r_Meteor"), ExtResource("r_Pyromancer"), ExtResource("r_Pyromancer")])
BonusApPerTurn = 1
RequiresDefeated = Array[String](["fire_initiate", "fire_adept", "fire_champion"])
LockedLine = "Prove yourself against the three duelists of this hall first - then I will face you."
