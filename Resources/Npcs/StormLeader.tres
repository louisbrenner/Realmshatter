[resource]
script = ExtResource("1_npc")
Id = "storm_leader"
Name = "Raijin"
Title = "Storm Circuit · Clan Leader"
Clan = 4
Deck = ExtResource("3_deck")
House = 4
Position = Vector2(480, 215)
Greeting = "I am Raijin, Storm Lord of the Circuit. My lightning never strikes the same place once. Ready?"
RematchLine = "The storm is restless. Again?"
DefeatLine = "You rode the storm. The Thunder Titan is yours to command."
VictoryLine = "Thunder answers only to me. Your gold, too, it seems."
RewardGold = 150
RewardCards = Array[ExtResource("2_card")]([ExtResource("r_ThunderTitan"), ExtResource("r_ThunderTitan"), ExtResource("r_StaticCharge"), ExtResource("r_StaticCharge"), ExtResource("r_StormCaller"), ExtResource("r_StormCaller")])
BonusApPerTurn = 1
RequiresDefeated = Array[String](["storm_initiate", "storm_adept", "storm_champion"])
LockedLine = "Prove yourself against the three duelists of this hall first - then I will face you."
