[resource]
script = ExtResource("1_npc")
Id = "healing_apprentice"
Name = "Lumen"
Title = "Dawn Novice"
Clan = 2
Deck = ExtResource("3_deck")
Position = Vector2(1550, 430)
Greeting = "Blessings to you, traveller! Sister Seraphine says a friendly duel heals the soul. Shall we?"
RematchLine = "Another friendly duel? My prayers are ready!"
DefeatLine = "You fought with heart. Please, take this Cleric - may it guard you."
VictoryLine = "Do not be sad - every loss is a lesson. Lessons have a small fee, though!"
RewardGold = 60
RewardCards = Array[ExtResource("2_card")]([ExtResource("r_Almoner"), ExtResource("r_Almoner"), ExtResource("r_Cleric"), ExtResource("r_Shrinekeeper")])
