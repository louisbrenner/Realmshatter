[resource]
script = ExtResource("1_npc")
id = "frost_leader"
name = "Isolde"
title = "Frostbound · Clan Leader"
clan = 3
deck = ExtResource("3_deck")
house = 3
position = Vector2(480, 215)
greeting = "I am Isolde, Winter Queen of the Frostbound. Patience wins every war. Shall I teach you?"
rematch_line = "Winter returns. It always does."
defeat_line = "You melted my winter. The Frost Wyrm will answer your call."
victory_line = "Stillness... and then defeat. Winter always collects its due."
reward_gold = 150
reward_cards = Array[ExtResource("2_card")]([ExtResource("r_FrostWyrm"), ExtResource("r_FrostWyrm"), ExtResource("r_Hailstorm"), ExtResource("r_Hailstorm"), ExtResource("r_AvalancheShaman"), ExtResource("r_AvalancheShaman")])
bonus_ap_per_turn = 1
requires_defeated = Array[String](["frost_initiate", "frost_adept", "frost_champion"])
locked_line = "Prove yourself against the three duelists of this hall first - then I will face you."
