[resource]
script = ExtResource("1_npc")
id = "healing_leader"
name = "Seraphine"
title = "Dawn Covenant · Clan Leader"
clan = 2
deck = ExtResource("3_deck")
house = 2
position = Vector2(480, 215)
greeting = "I am Seraphine, High Priestess of the Dawn Covenant. My pieces simply refuse to fall. Will you test them?"
rematch_line = "The dawn rises again. Shall we?"
defeat_line = "Light shines through you. The Archangel will walk at your side now."
victory_line = "Rest, child. The Covenant gratefully accepts your tithe."
reward_gold = 150
reward_cards = Array[ExtResource("2_card")]([ExtResource("r_Archangel"), ExtResource("r_Archangel"), ExtResource("r_MendingRain"), ExtResource("r_MendingRain"), ExtResource("r_Templar"), ExtResource("r_Templar")])
bonus_ap_per_turn = 1
requires_defeated = Array[String](["healing_initiate", "healing_adept", "healing_champion"])
locked_line = "Prove yourself against the three duelists of this hall first - then I will face you."
