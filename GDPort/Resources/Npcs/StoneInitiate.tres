[resource]
script = ExtResource("1_npc")
id = "stone_initiate"
name = "Pebble"
title = "Stone Bastion · Quarry Initiate"
clan = 5
house = 5
deck = ExtResource("3_deck")
position = Vector2(240, 470)
greeting = "They call me Pebble. I am small, but I do not roll over!"
rematch_line = "Rolling back for more?"
defeat_line = "Oof. Flattened. Good duel!"
victory_line = "Small stones start landslides! And small coins make big piles."
