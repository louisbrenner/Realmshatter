[resource]
script = ExtResource("1_npc")
id = "stone_apprentice"
name = "Bram"
title = "Quarry Hand"
clan = 5
deck = ExtResource("3_deck")
position = Vector2(1150, 370)
greeting = "Oi. Out of my quarry - unless you can push me out of it. Duel?"
rematch_line = "Back for more rocks to the face?"
defeat_line = "Hrmph. Solid play. Here, a Rock Slinger - aim for the knees."
victory_line = "Like pushing a mountain, eh? That'll cost you for the quarry damage."
reward_gold = 60
reward_cards = Array[ExtResource("2_card")]([ExtResource("r_QuarryHauler"), ExtResource("r_QuarryHauler"), ExtResource("r_Thornback"), ExtResource("r_Stonemason")])
