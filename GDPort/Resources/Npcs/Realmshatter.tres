[resource]
script = ExtResource("1_npc")
id = "realmshatter"
name = "Malrec"
title = "The Realmshatter · Endboss"
clan = 0
deck = ExtResource("3_deck")
position = Vector2(960, 400)
greeting = "So you broke all five clans. I broke the realm itself. Their legends kneel before my throne - win one, if you can."
rematch_line = "Back for another crown? The legends are still mine to give."
defeat_line = "Impossible... Take it. A legend should never serve a loser."
victory_line = "Shattered, like everyone before you."
reward_gold = 500
bonus_ap_per_turn = 2
reward_one_of = Array[ExtResource("2_card")]([ExtResource("l_Ignis"), ExtResource("l_Solenne"), ExtResource("l_Hrimgar"), ExtResource("l_Voltaris"), ExtResource("l_Gorran")])
requires_defeated = Array[String](["fire_leader", "healing_leader", "frost_leader", "storm_leader", "stone_leader"])
locked_line = "The Realmshatter only duels those who have humbled every clan leader. Come back when all five have fallen."
