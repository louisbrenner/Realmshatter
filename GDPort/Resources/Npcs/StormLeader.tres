[resource]
script = ExtResource("1_npc")
id = "storm_leader"
name = "Raijin"
title = "Storm Circuit · Clan Leader"
clan = 4
deck = ExtResource("3_deck")
house = 4
position = Vector2(480, 215)
greeting = "I am Raijin, Storm Lord of the Circuit. My lightning never strikes the same place once. Ready?"
rematch_line = "The storm is restless. Again?"
defeat_line = "You rode the storm. The Thunder Titan is yours to command."
victory_line = "Thunder answers only to me. Come back when you hear it."
reward_gold = 150
reward_cards = Array[ExtResource("2_card")]([ExtResource("r_ThunderTitan")])
bonus_ap_per_turn = 1
requires_defeated = Array[String](["storm_initiate", "storm_adept", "storm_champion"])
locked_line = "Prove yourself against the three duelists of this hall first - then I will face you."
