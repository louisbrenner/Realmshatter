[gd_resource type="Resource" script_class="NpcData" load_steps=7 format=3]

[ext_resource type="Script" path="res://Scripts/Data/NpcData.gd" id="1_npc"]
[ext_resource type="Script" path="res://Scripts/Data/CardData.gd" id="2_card"]
[ext_resource type="Resource" path="res://Resources/Decks/NpcFireApprentice.tres" id="3_deck"]
[ext_resource type="Resource" path="res://Resources/Cards/AshenRaider.tres" id="r_AshenRaider"]
[ext_resource type="Resource" path="res://Resources/Cards/EmberImp.tres" id="r_EmberImp"]
