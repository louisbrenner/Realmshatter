[resource]
script = ExtResource("1_npc")
id = "fire_apprentice"
name = "Kira"
title = "Ember Apprentice"
clan = 1
deck = ExtResource("3_deck")
position = Vector2(270, 430)
greeting = "Hey, you! I bet my embers burn hotter than anything in your deck. Wanna find out?"
rematch_line = "Back for another scorching? I have been practising!"
defeat_line = "Ow, ow, ow... fine, you win. Take this - you earned it."
victory_line = "Ha! Too hot to handle? Your coin purse melted - I'll take what dripped out."
reward_gold = 60
reward_cards = Array[ExtResource("2_card")]([ExtResource("r_AshenRaider"), ExtResource("r_AshenRaider"), ExtResource("r_EmberImp"), ExtResource("r_EmberEngineer")])
