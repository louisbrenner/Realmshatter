[resource]
script = ExtResource("1_deck")
name = "Dawn Covenant"
cards = Array[ExtResource("2_card")]([ExtResource("c_Acolyte"), ExtResource("c_DawnRanger"), ExtResource("c_Cleric"), ExtResource("c_Cleric"), ExtResource("c_Templar"), ExtResource("c_Templar"), ExtResource("c_Thornback"), ExtResource("c_Thornback"), ExtResource("c_Guardian"), ExtResource("c_Guardian"), ExtResource("c_BoneKnight"), ExtResource("c_BoneKnight"), ExtResource("c_Scout"), ExtResource("c_Scout"), ExtResource("c_Miner"), ExtResource("c_Merchant"), ExtResource("c_Blessing"), ExtResource("c_Blessing"), ExtResource("c_Sanctuary"), ExtResource("c_Sanctuary"), ExtResource("c_MendingRain"), ExtResource("c_MendingRain"), ExtResource("c_StoneWall"), ExtResource("c_StoneWall"), ExtResource("c_Archer"), ExtResource("c_Archer"), ExtResource("c_BattleCry"), ExtResource("c_BattleCry"), ExtResource("c_FlameArcher"), ExtResource("c_FlameArcher")])
description = "Outlast everything. Mending units, shields and sanctuaries keep your pieces alive in the zone. Splash: one fire archer."
accent_color = Color(1, 0.86, 0.45, 1)
showcase = ExtResource("c_Templar")
