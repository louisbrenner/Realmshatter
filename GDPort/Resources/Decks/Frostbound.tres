[resource]
script = ExtResource("1_deck")
name = "Frostbound"
cards = Array[ExtResource("2_card")]([ExtResource("c_FrostMage"), ExtResource("c_FrostMage"), ExtResource("c_IceSentinel"), ExtResource("c_IceSentinel"), ExtResource("c_Guardian"), ExtResource("c_RimeStalker"), ExtResource("c_Lancer"), ExtResource("c_Lancer"), ExtResource("c_FrostArcher"), ExtResource("c_FrostArcher"), ExtResource("c_Scout"), ExtResource("c_Scout"), ExtResource("c_Miner"), ExtResource("c_Merchant"), ExtResource("c_Frostbite"), ExtResource("c_Frostbite"), ExtResource("c_Hailstorm"), ExtResource("c_Hailstorm"), ExtResource("c_Gale"), ExtResource("c_Gale"), ExtResource("c_StoneWall"), ExtResource("c_StoneWall"), ExtResource("c_Weaken"), ExtResource("c_Weaken"), ExtResource("c_BoneKnight"), ExtResource("c_BoneKnight"), ExtResource("c_Sanctuary"), ExtResource("c_Sanctuary"), ExtResource("c_Swordsman"), ExtResource("c_Swordsman")])
description = "Lock the board down. Freeze and weaken enemies, wall off lanes and pierce through the gaps. Splash: a sanctuary."
