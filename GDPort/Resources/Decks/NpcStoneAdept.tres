cards = Array[ExtResource("2_card")]([ExtResource("c_Swordsman"), ExtResource("c_Swordsman"), ExtResource("c_Swordsman"), ExtResource("c_Guardian"), ExtResource("c_Guardian"), ExtResource("c_Lancer"), ExtResource("c_Lancer"), ExtResource("c_Lancer"), ExtResource("c_Archer"), ExtResource("c_Miner"), ExtResource("c_Miner"), ExtResource("c_Merchant"), ExtResource("c_ManaSurge"), ExtResource("c_ManaSurge"), ExtResource("c_StonePathfinder"), ExtResource("c_StonePathfinder"), ExtResource("c_RockSlinger"), ExtResource("c_RockSlinger"), ExtResource("c_RockSlinger"), ExtResource("c_Thornback"), ExtResource("c_Thornback"), ExtResource("c_BatteringRam"), ExtResource("c_BatteringRam"), ExtResource("c_QuarryHauler"), ExtResource("c_RichVein"), ExtResource("c_Stoneskin"), ExtResource("c_Stoneskin"), ExtResource("c_Gale"), ExtResource("c_Stonemason"), ExtResource("c_SiegeEngineer")])
