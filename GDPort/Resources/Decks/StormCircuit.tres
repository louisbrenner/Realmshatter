[resource]
script = ExtResource("1_deck")
name = "Storm Circuit"
cards = Array[ExtResource("2_card")]([ExtResource("c_SparkTotem"), ExtResource("c_SparkTotem"), ExtResource("c_Bellringer"), ExtResource("c_Bellringer"), ExtResource("c_StormCaller"), ExtResource("c_StormCaller"), ExtResource("c_PowderKeg"), ExtResource("c_PowderKeg"), ExtResource("c_Archer"), ExtResource("c_StormRunner"), ExtResource("c_Lancer"), ExtResource("c_Lancer"), ExtResource("c_Swordsman"), ExtResource("c_Swordsman"), ExtResource("c_Scout"), ExtResource("c_Scout"), ExtResource("c_Merchant"), ExtResource("c_Miner"), ExtResource("c_Overcharge"), ExtResource("c_Overcharge"), ExtResource("c_StaticCharge"), ExtResource("c_StaticCharge"), ExtResource("c_LightningBolt"), ExtResource("c_LightningBolt"), ExtResource("c_BattleCry"), ExtResource("c_BattleCry"), ExtResource("c_FlameArcher"), ExtResource("c_FlameArcher"), ExtResource("c_Cleric"), ExtResource("c_Cleric")])
description = "Arcing lightning: bolts jump between pieces, echoes strike twice and overcharges double the damage. Mind your own lines! Splash: fire and healing."
accent_color = Color(0.68, 0.58, 1, 1)
showcase = ExtResource("c_StormCaller")
