[resource]
script = ExtResource("1_deck")
name = "Storm Circuit"
cards = Array[ExtResource("2_card")]([ExtResource("c_SparkTotem"), ExtResource("c_SparkTotem"), ExtResource("c_Bellringer"), ExtResource("c_Bellringer"), ExtResource("c_StormCaller"), ExtResource("c_Archer"), ExtResource("c_Archer"), ExtResource("c_Lancer"), ExtResource("c_Swordsman"), ExtResource("c_Scout"), ExtResource("c_Merchant"), ExtResource("c_Miner"), ExtResource("c_Overcharge"), ExtResource("c_Overcharge"), ExtResource("c_StaticCharge"), ExtResource("c_LightningBolt"), ExtResource("c_LightningBolt"), ExtResource("c_BattleCry"), ExtResource("c_FlameArcher"), ExtResource("c_Cleric")])
description = "Build chains. Hit your own relays to fire lightning across the board, then overcharge them. Splash: fire and healing."
