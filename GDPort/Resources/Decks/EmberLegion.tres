[resource]
script = ExtResource("1_deck")
name = "Ember Legion"
cards = Array[ExtResource("2_card")]([ExtResource("c_EmberImp"), ExtResource("c_EmberImp"), ExtResource("c_FlameArcher"), ExtResource("c_FlameArcher"), ExtResource("c_Pyromancer"), ExtResource("c_BatteringRam"), ExtResource("c_Swordsman"), ExtResource("c_Swordsman"), ExtResource("c_Scout"), ExtResource("c_Miner"), ExtResource("c_Merchant"), ExtResource("c_Fireball"), ExtResource("c_Fireball"), ExtResource("c_Meteor"), ExtResource("c_FlameWall"), ExtResource("c_BattleCry"), ExtResource("c_BattleCry"), ExtResource("c_SparkTotem"), ExtResource("c_Cleric"), ExtResource("c_Blessing")])
description = "Scorch the board. Burning units and fire spells turn tiles into Lava that wears enemies down. Splash: a little healing."
accent_color = Color(1, 0.45, 0.15, 1)
showcase = ExtResource("c_Pyromancer")
