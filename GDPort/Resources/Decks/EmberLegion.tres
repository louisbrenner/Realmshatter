[resource]
script = ExtResource("1_deck")
name = "Ember Legion"
cards = Array[ExtResource("2_card")]([ExtResource("c_EmberImp"), ExtResource("c_EmberImp"), ExtResource("c_EmberImp"), ExtResource("c_EmberStalker"), ExtResource("c_EmberStalker"), ExtResource("c_FlameArcher"), ExtResource("c_FlameArcher"), ExtResource("c_FlameArcher"), ExtResource("c_Berserker"), ExtResource("c_Berserker"), ExtResource("c_CinderWraith"), ExtResource("c_CinderWraith"), ExtResource("c_Pyromancer"), ExtResource("c_Pyromancer"), ExtResource("c_AshenRaider"), ExtResource("c_AshenRaider"), ExtResource("c_CinderMortar"), ExtResource("c_Phoenix"), ExtResource("c_Miner"), ExtResource("c_Miner"), ExtResource("c_Lancer"), ExtResource("c_Lancer"), ExtResource("c_PyreOffering"), ExtResource("c_PyreOffering"), ExtResource("c_Fireball"), ExtResource("c_Fireball"), ExtResource("c_Meteor"), ExtResource("c_FlameWall"), ExtResource("c_EmberEngineer"), ExtResource("c_FlameWarden")])
description = "Scorch the board. Burning units and fire spells turn tiles into Lava that wears enemies down. Splash: a little healing."
accent_color = Color(1, 0.45, 0.15, 1)
showcase = ExtResource("c_Pyromancer")
